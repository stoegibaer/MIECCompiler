/* MIEC.atg - Attributierte Grammatik f�r MiniIEC Compiler
 * Compiler Engineering, FH-O� Hagenberg
 * Phase 1: Scanner und Parser f�r Syntaxanalyse
 */
 #include <iostream>
 #include <codecvt>
 #include <locale>

COMPILER MIEC
CHARACTERS
  letter = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz".
  digit  = "0123456789".
  cr     = '\r'.
  lf     = '\n'.
  tab    = '\t'.
TOKENS
  ident  = letter {letter | digit | '_'}.
  number = digit {digit}.
COMMENTS FROM "(*" TO "*)"
IGNORE cr + lf + tab

PRODUCTIONS
/*----------------------------------TOP-------------------------------------*/
MIEC
= "PROGRAM" ident
  [ VarDecl ]
  "BEGIN"
  Statements
  "END"
.
/*--------------------------------------------------------------------------*/
VarDecl
= "BEGIN_VAR"
  VarDeclList
  "END_VAR"
.
/*--------------------------------------------------------------------------*/
VarDeclList
= ident ':' "Integer" ';'
  { ident ':' "Integer" ';' }
.
/*--------------------------------------------------------------------------*/
Statements
= { Stat }
.
/*--------------------------------------------------------------------------*/
Stat
= Assignment
| PrintStatement
| WhileStatement
| IfStatement
.
/*--------------------------------------------------------------------------*/
Assignment
= ident ":=" Expr ';'
.
/*--------------------------------------------------------------------------*/
PrintStatement
= 
(. int startExpr = 0; .)
(. int endExpr = 0; .)
(. std::wstring_convert<std::codecvt_utf8<wchar_t>> conv; .)
"print" 
'(' 
(. startExpr = la->pos; .)
Expr 
(. endExpr = la->pos; .)
')' 
';'
(. std::cout << conv.to_bytes(scanner->buffer->GetString(startExpr, endExpr)) << std::endl; .)
.
/*--------------------------------------------------------------------------*/
WhileStatement
= "WHILE" Condition "DO"
  Statements
  "END"
.
/*--------------------------------------------------------------------------*/
IfStatement
= "IF" Condition "THEN"
  Statements
  [ "ELSE" Statements ]
  "END"
.
/*--------------------------------------------------------------------------*/
Expr
= Term { AddOp Term }
.
/*--------------------------------------------------------------------------*/
Term
= Factor { MulOp Factor }
.
/*--------------------------------------------------------------------------*/
Factor
= ident
| number
| '(' Expr ')'
.
/*--------------------------------------------------------------------------*/
Condition
= Expr Relop Expr
.
/*--------------------------------------------------------------------------*/
Relop
= '='
| "<="
| ">="
| "!="
| '<'
| '>'
.
/*--------------------------------------------------------------------------*/
AddOp
= '+'
| '-'
.
/*--------------------------------------------------------------------------*/
MulOp
= '*'
| '/'
.
END MIEC.