PROGRAM Test02_Arithmetic
BEGIN_VAR
   a : Integer;
   b : Integer;
   sum : Integer;
   diff : Integer;
   prod : Integer;
   quot : Integer;
END_VAR
BEGIN
   a := 20;
   b := 4;
   sum := a + b;
   diff := a - b;
   prod := a * b;
   quot := a / b;
   print(sum);
   print(diff);
   print(prod);
   print(quot);
END
