PROGRAM Test08_Nested
BEGIN_VAR
   i : Integer;
   j : Integer;
   count : Integer;
END_VAR
BEGIN
   count := 0;
   i := 1;
   
   WHILE i <= 3 DO
      j := 1;
      WHILE j <= 2 DO
         IF i = 2 THEN
            count := count + 10;
         ELSE
            count := count + 1;
         END
         j := j + 1;
      END
      i := i + 1;
   END
   
   print(count);
END
